<mujoco model="Unitree G1 29DOF">
    <include file="g1_29dof.xml" pos="0 0 0"/>
    <option timestep="0.005" iterations="50" solver="PGS" jacobian="sparse" gravity="0 0 -9.81"/>
    <visual>
        <map force="0.001" /> <!-- Adjust this to make red lines longer/shorter -->
        <global offwidth="800" offheight="800" />
    </visual>

    <worldbody>
        <light diffuse=".5 .5 .5" pos="0 0 4" dir="0 0 -1"/>
        
        
        
        <geom name="floor" type="plane" size="6 6 0.1" rgba=".9 .9 .9 1" friction="3 0.5 0.5" solref="0.02 1" solimp="0.9 0.95 0.001"/> 
        <geom name="wall_north" type="box" size="6 0.1 1.5" pos="0 6 1.5" rgba=".8 .8 .8 1"/>
        <geom name="wall_south" type="box" size="6 0.1 1.5" pos="0 -6 1.5" rgba=".8 .8 .8 1"/>
        <geom name="wall_east" type="box" size="0.1 6 1.5" pos="6 0 1.5" rgba=".8 .8 .8 1"/>
        <geom name="wall_west" type="box" size="0.1 6 1.5" pos="-6 0 1.5" rgba=".8 .8 .8 1"/>

        <geom name="machine_1" type="box" size="0.6 0.8 1.0" pos="-2.5 2.0 1.0" rgba="0.2 0.4 0.6 1"/>
        <geom name="machine_2" type="box" size="0.6 0.8 1.0" pos="2.5 0.0 1.0" rgba="0.2 0.4 0.6 1"/>

        <geom name="table_1_top" type="box" size="0.7 0.7 0.05" pos="-2.5 -2.5 0.75" rgba="0.4 0.3 0.2 1"/>
        <geom name="table_1_leg" type="cylinder" size="0.05 0.37" pos="-2.5 -2.5 0.37" rgba="0.2 0.2 0.2 1"/>

        <geom name="goal_table_top" type="box" size="1.2 0.6 0.05" pos="0 5 0.8" rgba="0.4 0.3 0.2 1"/>
        <geom name="goal_table_leg_l" type="box" size="0.05 0.6 0.4" pos="-1.15 5 0.4" rgba="0.2 0.2 0.2 1"/>
        <geom name="goal_table_leg_r" type="box" size="0.05 0.6 0.4" pos="1.15 5 0.4" rgba="0.2 0.2 0.2 1"/>

        <geom name="pouch_1" type="box" size="0.06 0.08 0.02" pos="-0.3 5 0.87" rgba="1 0.8 0 1"/>
        <geom name="pouch_2" type="box" size="0.06 0.08 0.02" pos="0.0 5 0.87" rgba="1 0.8 0 1"/>
        <geom name="pouch_3" type="box" size="0.06 0.08 0.02" pos="0.3 5 0.87" rgba="1 0.8 0 1"/>

        
    </worldbody>

    <visual>
        <headlight ambient=".4 .4 .4" diffuse=".8 .8 .8" specular="0.1 0.1 0.1"/>
        <map znear="0.01"/>
    </visual>
</mujoco>